<Window x:Class="SheetNumber.UI.SheetNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Number"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="#333333"
                   Margin="0,0,0,16"
                   Text="Step 1 saves the current main parameter into the destination parameter. Step 2 places the two chosen parameters, one after the other, at the start of the main parameter." />

        <Border Grid.Row="1" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="1. Copy parameter" />
                <TextBlock Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Choose the sheet parameter to read, and the parameter that receives that value." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,4" Text="Main Parameter" />
                        <ComboBox x:Name="MainParameterCombo" Height="28" MaxDropDownHeight="360" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4" Text="Destination Parameter" />
                        <ComboBox x:Name="DestinationParameterCombo" Height="28" MaxDropDownHeight="360" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="2. Add to the start of the main parameter" />
                <TextBlock Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="These two values are joined and placed in front of the main parameter. FLS and 1 in front of 21201 become FLS121201." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,4" Text="First parameter" />
                        <ComboBox x:Name="FirstPrefixCombo" Height="28" MaxDropDownHeight="360" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4" Text="Second parameter" />
                        <ComboBox x:Name="SecondPrefixCombo" Height="28" MaxDropDownHeight="360" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="SkipPrefixedCheckBox" Margin="0,12,0,0"
                          Content="Skip sheets whose main parameter already starts with these two values" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#F4F7FB" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Preview" />
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock x:Name="SheetCountText" VerticalAlignment="Center" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,210,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Content="Apply" Width="96" Height="30" Margin="0,0,8,0" IsDefault="True" Click="Apply_Click" />
                <Button Content="Cancel" Width="96" Height="30" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
